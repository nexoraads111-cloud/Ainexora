# Instagram Graph API (free, official Meta API — no Buffer/Later/etc.)
# 1) developers.facebook.com → create Business app
# 2) Get a Page access token with:
#    instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement
# 3) Run: npm run whoami   (prints Page + Instagram IDs)

IG_USER_ID=
PAGE_ACCESS_TOKEN=

